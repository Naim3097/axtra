rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper function to check if user is agency
    function isAgency() {
      return request.auth != null && (
        request.auth.token.email == 'sales@nexovadigital.com' ||
        request.auth.token.email == 'agency@nexovadigital.com'
      );
    }
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Deliverables - agency uploads drafts here, clients can view their own
    // Path format: deliverables/{email}/{filename}
    // Note: email contains @ and . characters (e.g., hello@leanis.com.my)
    match /deliverables/{allPaths=**} {
      allow read: if isAuthenticated();  // Any authenticated user can read deliverables
      allow write: if isAgency();        // Only agency can write
    }
    
    // Content directions
    match /contentDirections/{userId}/{fileName=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAgency());
    }
    
    // Revisions
    match /revisions/{userId}/{fileName=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAgency());
    }
    
    // Content submissions
    match /contentSubmissions/{userId}/{fileName=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAgency());
    }
    
    // Reports, invoices, billing
    match /reports/{clientEmail}/{fileName=**} {
      allow read: if isAuthenticated();
      allow write: if isAgency();
    }
    
    match /invoices/{clientEmail}/{fileName=**} {
      allow read: if isAuthenticated();
      allow write: if isAgency();
    }
    
    match /billing/{clientEmail}/{fileName=**} {
      allow read: if isAuthenticated();
      allow write: if isAgency();
    }
    
    // Default fallback
    match /{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAgency();
    }
  }
}
